# =============================================================================
# Sales OS - Environment Configuration Template
# =============================================================================
# Copy this file to .env and update the values for your environment
# NEVER commit .env files to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development          # development, staging, production
DEBUG=true                       # Enable debug mode (disable in production)
SECRET_KEY=your-secret-key-here  # Generate with: openssl rand -hex 32

# -----------------------------------------------------------------------------
# Backend Service
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR, CRITICAL

# -----------------------------------------------------------------------------
# Frontend Service
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sales_os
POSTGRES_PASSWORD=sales_os_dev   # Change in production!
POSTGRES_DB=sales_os

# Constructed database URL (used by backend)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# -----------------------------------------------------------------------------
# Development Tools (Optional)
# -----------------------------------------------------------------------------
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@salesos.local
PGADMIN_PASSWORD=admin           # Change in production!
REDIS_COMMANDER_PORT=8081

# -----------------------------------------------------------------------------
# Authentication (Configure based on your auth provider)
# -----------------------------------------------------------------------------
# JWT_SECRET=your-jwt-secret
# JWT_EXPIRATION=3600
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# External Services (Add as needed)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SENDGRID_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# Monitoring & Observability (Optional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# DATADOG_API_KEY=
# NEW_RELIC_LICENSE_KEY=
