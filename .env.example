# Sales OS Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# APPLICATION
# ===========================================
ENVIRONMENT=development
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
CORS_ORIGINS=http://localhost:3000

# ===========================================
# DATABASE
# ===========================================
POSTGRES_USER=salesos
POSTGRES_PASSWORD=salesos_dev_password
POSTGRES_DB=salesos
DATABASE_URL=postgresql://salesos:salesos_dev_password@localhost:5432/salesos

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# CLAUDE AI (Required)
# ===========================================
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ===========================================
# HUBSPOT INTEGRATION
# ===========================================
HUBSPOT_API_KEY=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/integrations/hubspot/callback

# ===========================================
# SALESFORCE INTEGRATION
# ===========================================
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:8000/api/integrations/salesforce/callback

# ===========================================
# AVOMA INTEGRATION
# ===========================================
AVOMA_API_KEY=
AVOMA_WEBHOOK_SECRET=

# ===========================================
# ZOOM INTEGRATION
# ===========================================
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/api/integrations/zoom/callback
ZOOM_WEBHOOK_SECRET=

# ===========================================
# GONG INTEGRATION
# ===========================================
GONG_API_KEY=
GONG_API_SECRET=

# ===========================================
# SLACK INTEGRATION
# ===========================================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/integrations/slack/callback

# ===========================================
# GOOGLE CALENDAR INTEGRATION
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# ===========================================
# MICROSOFT/OUTLOOK INTEGRATION
# ===========================================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/integrations/microsoft/callback

# ===========================================
# LINKEDIN INTEGRATION
# ===========================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ===========================================
# EMAIL SERVICE (SendGrid or AWS SES)
# ===========================================
EMAIL_PROVIDER=sendgrid  # sendgrid or ses
SENDGRID_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Sales OS

# ===========================================
# FILE STORAGE (S3 Compatible)
# ===========================================
STORAGE_PROVIDER=local  # local, s3, or r2
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=  # For R2 or MinIO

# ===========================================
# FRONTEND
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sales OS

# ===========================================
# MONITORING (Optional)
# ===========================================
SENTRY_DSN=
LOG_LEVEL=INFO
