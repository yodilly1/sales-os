# Sales OS Backend Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=Sales OS
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# API
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000"]

# Avoma Integration
AVOMA_CLIENT_ID=your-avoma-client-id
AVOMA_CLIENT_SECRET=your-avoma-client-secret
AVOMA_API_KEY=your-avoma-api-key
AVOMA_WEBHOOK_SECRET=your-avoma-webhook-secret
AVOMA_REDIRECT_URI=http://localhost:8000/api/avoma/oauth/callback

# HubSpot Integration (optional)
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_API_KEY=your-hubspot-api-key

# Database
DATABASE_URL=sqlite:///./sales_os.db

# Claude API
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Logging
LOG_LEVEL=INFO
