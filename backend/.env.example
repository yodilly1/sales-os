# Application Settings
APP_NAME=Sales OS
APP_ENV=development
DEBUG=true
API_VERSION=v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sales_os
# For SQLite (development): sqlite+aiosqlite:///./sales_os.db

# Redis Settings (for background tasks)
REDIS_URL=redis://localhost:6379/0

# Claude API
ANTHROPIC_API_KEY=your-api-key-here

# HubSpot Integration
HUBSPOT_API_KEY=your-hubspot-api-key
HUBSPOT_CLIENT_ID=your-client-id
HUBSPOT_CLIENT_SECRET=your-client-secret

# Avoma Integration
AVOMA_API_KEY=your-avoma-api-key
AVOMA_WEBHOOK_SECRET=your-webhook-secret

# Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Export Settings
EXPORT_MAX_RECORDS=10000
EXPORT_TEMP_DIR=/tmp/sales_os_exports
EXPORT_RETENTION_HOURS=24

# Import Settings
IMPORT_MAX_FILE_SIZE_MB=50
IMPORT_BATCH_SIZE=100
