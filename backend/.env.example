# Sales OS Backend Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=Sales OS
APP_VERSION=0.1.0
DEBUG=false

# =============================================================================
# Claude AI Configuration
# =============================================================================
# Your Anthropic API key (required for content generation)
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude model to use (default: claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Max tokens for Claude responses
CLAUDE_MAX_TOKENS=4096

# =============================================================================
# Database Configuration
# =============================================================================
# SQLite (default for development)
DATABASE_URL=sqlite:///./sales_os.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/sales_os

# =============================================================================
# Security Settings
# =============================================================================
# JWT secret key (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT algorithm
JWT_ALGORITHM=HS256

# Token expiration (in minutes)
JWT_EXPIRATION_MINUTES=1440

# =============================================================================
# HubSpot Integration (optional)
# =============================================================================
HUBSPOT_API_KEY=
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=

# =============================================================================
# Avoma Integration (optional)
# =============================================================================
AVOMA_API_KEY=

# =============================================================================
# Content Generation Settings
# =============================================================================
# Max retry attempts for content generation
CONTENT_MAX_RETRIES=3

# Default brand voice (professional, conversational, technical, executive)
CONTENT_DEFAULT_BRAND_VOICE=professional
