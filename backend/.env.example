# Sales OS Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME="Sales OS"
APP_VERSION="0.1.0"
DEBUG=false

# HubSpot Integration
# Option 1: Private App API Key (simpler, recommended for testing)
HUBSPOT_API_KEY=your-hubspot-private-app-api-key

# Option 2: OAuth2 (for production with user authorization)
HUBSPOT_CLIENT_ID=your-hubspot-oauth-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-oauth-client-secret
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/hubspot/oauth/callback

# HubSpot API Settings
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_RATE_LIMIT_REQUESTS=100
HUBSPOT_RATE_LIMIT_WINDOW=10

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_os

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=your-secure-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Avoma Integration (for future use)
AVOMA_API_KEY=your-avoma-api-key
