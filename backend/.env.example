# Sales OS Backend Configuration
# Copy this file to .env and fill in the values

# Application
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sales_os

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 Storage Configuration
# For AWS S3:
# S3_ENDPOINT_URL=  (leave empty for AWS)
# S3_REGION=us-east-1
#
# For MinIO (local development):
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1

S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=sales-os-files

# File Upload Settings
MAX_FILE_SIZE_MB=100
CHUNK_SIZE_MB=5
UPLOAD_TEMP_DIR=/tmp/sales-os-uploads
FILE_RETENTION_DAYS=30
TEMP_FILE_EXPIRY_HOURS=24

# JWT Settings
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256

# Claude API (for AI features)
ANTHROPIC_API_KEY=your-api-key-here

# HubSpot Integration
HUBSPOT_API_KEY=your-hubspot-api-key
HUBSPOT_PORTAL_ID=your-portal-id

# Avoma Integration
AVOMA_API_KEY=your-avoma-api-key
