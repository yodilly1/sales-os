# Application
ENV=development
DEBUG=true
APP_NAME="Sales OS"

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sales_os

# JWT Configuration - CHANGE IN PRODUCTION
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# HubSpot OAuth2
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/auth/hubspot/callback
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.contacts.write crm.objects.deals.read crm.objects.deals.write

# Avoma OAuth2
AVOMA_CLIENT_ID=your-avoma-client-id
AVOMA_CLIENT_SECRET=your-avoma-client-secret
AVOMA_REDIRECT_URI=http://localhost:8000/api/auth/avoma/callback
AVOMA_API_KEY=your-avoma-api-key

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Audit Logging
AUDIT_LOG_ENABLED=true
