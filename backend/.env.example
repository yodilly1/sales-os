# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sales_os
# For development with SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./sales_os.db

# Application
FASTAPI_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# API Keys (to be added by integration agents)
# CLAUDE_API_KEY=
# HUBSPOT_API_KEY=
# AVOMA_API_KEY=

# Activity Logging
ACTIVITY_LOG_RETENTION_DAYS=90
ACTIVITY_LOG_BATCH_SIZE=100
ACTIVITY_LOG_ENABLED=true
